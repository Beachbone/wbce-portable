function LoadLogo(AImage: TImage): Boolean;
var
  ms: TMemoryStream;
  png: TPortableNetworkGraphic;
begin
  Result := False;
  ms := TMemoryStream.Create;
  png := TPortableNetworkGraphic.Create;
  try
    try
      ms.WriteBuffer(LogoPng[0], SizeOf(LogoPng));
      ms.Position := 0;
      png.LoadFromStream(ms);
      AImage.Picture.Assign(png);
      Result := True;
    except
      Result := False;   // ohne Logo laeuft das Programm trotzdem
    end;
  finally
    png.Free;
    ms.Free;
  end;
end;

end.
